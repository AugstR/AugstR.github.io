---
// Estructura común: <head>, menú y pie. La usan la portada y las páginas de cada proyecto.
import { ClientRouter } from 'astro:transitions';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400-italic.css';
import '@fontsource/ibm-plex-sans/latin-500.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string; // URL absoluta
  ogType?: string;
  schema?: object;
  inicio?: boolean; // en la portada el menú usa anclas (#seccion); en el resto, /#seccion
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = 'https://augstr.github.io/img/Augusto2.jpg',
  ogType = 'website',
  schema,
  inicio = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ir = (id: string) => (inicio ? `#${id}` : `/#${id}`);
const actualizado = new Date().toLocaleDateString('es-AR', { month: 'long', year: 'numeric' });
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content="#f3f1ea" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#121417" media="(prefers-color-scheme: dark)">
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="es_AR">
  <meta name="twitter:card" content={ogImage.includes('/_astro/') ? 'summary_large_image' : 'summary'}>
  {schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <script is:inline>
    try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <ClientRouter />
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>

  <header class="nav">
    <div class="nav__inner container">
      <a href={inicio ? '#contenido' : '/'} class="nav__brand">
        <svg class="nav__mark" viewBox="1.5 3.5 28 25" aria-hidden="true">
          <g fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5.5 26.5 L10.5 5 L15 27 M15 27 L15 7.5 M15 7.5 C22.5 5.5 24 14 16.5 15.5 L22 26.5 C24.8 27.4 26.4 25 25.2 23.4 C24 21.8 21.6 22.6 20.4 23.8 C18.9 25.1 16.8 26.4 15 27" stroke="currentColor"/>
            <path d="M2.5 18.5 L25 16.3 M2.5 18.5 L15 27 L28.5 4.5" stroke="var(--accent)"/>
          </g>
        </svg>
        <span>Augusto Roubineau <span class="nav__path mono">/ cv</span></span>
      </a>

      <nav class="nav__links" id="menu" aria-label="Secciones">
        <a href={ir('sobre-mi')}>Sobre mí</a>
        <a href={ir('experiencia')}>Experiencia</a>
        <a href={ir('proyectos')}>Proyectos</a>
        <a href={ir('skills')}>Skills</a>
        <a href={ir('formacion')}>Formación</a>
        <a href={ir('contacto')}>Contacto</a>
        <a href="/cv.pdf" class="nav__cta mono" data-astro-reload>CV en PDF ↓</a>
      </nav>

      <div class="nav__actions">
        <button class="icon-btn" id="themeToggle" aria-label="Cambiar tema">
          <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
        <button class="icon-btn nav__burger" id="burger" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu">
          <span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <main id="contenido" tabindex="-1">
    <slot />
  </main>

  <footer class="footer container mono">
    <span>© {new Date().getFullYear()} Augusto Roubineau · actualizado en {actualizado}</span>
    <a href={inicio ? '#contenido' : '/'}>{inicio ? 'Volver arriba ↑' : '← Volver al inicio'}</a>
  </footer>

  <script>
    import '../scripts/main';
  </script>
</body>
</html>
