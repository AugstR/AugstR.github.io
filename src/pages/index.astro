---
import { CREDLY_CCNA, EMAIL, EXPERIENCIA, FORMACION, GITHUB, IDIOMAS, INTERESES, LINKEDIN, SKILLS } from '../data/cv';
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { TIPOS } from '../data/proyectos';
import { capturaDe, listarProyectos } from '../data/coleccion';

const PROYECTOS = await listarProyectos();
// Solo se ofrecen en el filtro los tipos que tienen al menos un proyecto
const tipos = (Object.keys(TIPOS) as (keyof typeof TIPOS)[])
  .map((t) => ({ tipo: t, nombre: TIPOS[t], cantidad: PROYECTOS.filter((p) => p.tipo === t).length }))
  .filter((t) => t.cantidad > 0);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Augusto Roubineau',
  url: 'https://augstr.github.io/',
  image: 'https://augstr.github.io/img/Augusto2.jpg',
  jobTitle: 'Pasante de Ingeniería',
  worksFor: { '@type': 'Organization', name: 'OneCloud' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'UADE · Universidad Argentina de la Empresa' },
  address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
  email: `mailto:${EMAIL}`,
  knowsAbout: ['Veeam', 'VMware Cloud Director', 'Nutanix', 'Backup y recuperación ante desastres', 'Redes', 'Linux', 'Active Directory'],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'CCNA: Introduction to Networks',
    credentialCategory: 'badge',
    recognizedBy: { '@type': 'Organization', name: 'Cisco' },
    url: CREDLY_CCNA,
  },
  sameAs: [LINKEDIN, GITHUB],
};

const iconoLinkedin = 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3zM9.5 9.75h3.8v1.5h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1v5.45h-4v-4.83c0-1.15-.02-2.63-1.6-2.63-1.6 0-1.85 1.25-1.85 2.55v4.91h-4z';
---
<Base
  title="Augusto Roubineau · Infraestructura & Cloud"
  description="Augusto Roubineau — Pasante de Ingeniería en OneCloud (Powercloud): backup con Veeam, VMware Cloud Director y Nutanix. Ex Pasante IT en Amcor y estudiante de Gestión de Tecnologías de la Información en UADE."
  ogDescription="Pasante de Ingeniería en OneCloud: backup con Veeam, VMware Cloud Director y Nutanix. Cisco CCNA: Introduction to Networks."
  ogType="profile"
  schema={schema}
  inicio
>

    <!-- ============ HERO ============ -->
    <section class="hero container">
      <div class="hero__text">
        <div class="hero__id">
          <img class="hero__photo" src="/img/Augusto2.jpg" alt="Retrato de Augusto Roubineau" width="663" height="712">
          <p class="hero__kicker mono">Infraestructura · Backup · Cloud</p>
        </div>
        <h1 class="hero__title">Augusto Roubineau</h1>
        <p class="hero__lead">
          Implemento soluciones de respaldo, virtualización y nube para clientes corporativos.
          Hoy trabajo con <strong>Veeam</strong>, <strong>VMware Cloud Director</strong> y <strong>Nutanix</strong>;
          el rumbo es <strong>DevOps y operaciones</strong>.
        </p>
        <div class="hero__buttons">
          <a class="btn btn--primary" href="#proyectos">Ver proyectos</a>
          <a class="btn btn--ghost" href="/cv.pdf" data-astro-reload>Descargar CV <span class="mono">PDF</span></a>
          <a class="btn btn--ghost" href={LINKEDIN} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={iconoLinkedin}/></svg>
            LinkedIn
          </a>
        </div>
      </div>

      <figure class="schema">
        <svg class="schema__svg" viewBox="0 0 380 420" role="img" aria-labelledby="schemaTitulo schemaDesc">
          <title id="schemaTitulo">Esquema de backup con repositorio endurecido</title>
          <desc id="schemaDesc">Las máquinas virtuales de producción se respaldan con Veeam Backup &amp; Replication en un Veeam Hardened Repository sobre Ubuntu con RAID. Las copias son inmutables: un ransomware no puede borrarlas ni cifrarlas.</desc>

          <rect class="s-box" x="16" y="12" width="230" height="64"/>
          <text class="s-k" x="30" y="34">PRODUCCIÓN</text>
          <text class="s-t" x="30" y="58">VMs · VMware Cloud Director</text>

          <line class="s-flow" x1="131" y1="76" x2="131" y2="122"/>
          <path class="s-head" d="M126 118 L131 127 L136 118 Z"/>
          <text class="s-k" x="142" y="104">job de backup</text>

          <rect class="s-box" x="16" y="128" width="230" height="64"/>
          <text class="s-k" x="30" y="150">ORQUESTACIÓN</text>
          <text class="s-t" x="30" y="174">Veeam Backup &amp; Replication</text>

          <line class="s-flow" x1="131" y1="192" x2="131" y2="238"/>
          <path class="s-head" d="M126 234 L131 243 L136 234 Z"/>
          <text class="s-k" x="142" y="220">escritura</text>

          <rect class="s-box s-box--key" x="16" y="244" width="230" height="150"/>
          <text class="s-k" x="30" y="266">REPOSITORIO ENDURECIDO</text>
          <text class="s-t" x="30" y="290">Veeam Hardened Repository</text>
          <rect class="s-chip" x="30" y="306" width="62" height="22"/>
          <text class="s-chip-t" x="38" y="321">Ubuntu</text>
          <rect class="s-chip" x="100" y="306" width="44" height="22"/>
          <text class="s-chip-t" x="108" y="321">RAID</text>
          <rect class="s-chip" x="30" y="336" width="122" height="22"/>
          <text class="s-chip-t" x="38" y="351">copias inmutables</text>
          <path class="s-lock" d="M210 340 v-8 a8 8 0 0 1 16 0 v8 M205 340 h26 v20 h-26 Z"/>

          <text class="s-bad-t" x="268" y="300">ransomware</text>
          <line class="s-bad" x1="370" y1="312" x2="262" y2="312"/>
          <path class="s-x" d="M251 306 l12 12 M263 306 l-12 12"/>
          <text class="s-k" x="268" y="334">no puede borrar</text>
          <text class="s-k" x="268" y="348">ni cifrar copias</text>
        </svg>
        <figcaption class="mono">Fig. 1 — El tipo de infraestructura que implemento: backup con Veeam sobre un repositorio Linux endurecido, con copias inmutables contra ransomware.</figcaption>
      </figure>

      <dl class="spec">
        <div><dt>Puesto actual</dt><dd>Pasante de Ingeniería · OneCloud</dd></div>
        <div><dt>Plataformas</dt><dd>Veeam · VMware · Nutanix</dd></div>
        <div><dt>Certificación</dt><dd><a href={CREDLY_CCNA} target="_blank" rel="noopener">Cisco CCNA: ITN ↗</a></dd></div>
        <div><dt>Base</dt><dd>Buenos Aires · de Corrientes</dd></div>
        <div><dt>Rumbo</dt><dd>DevOps y operaciones</dd></div>
      </dl>
    </section>

    <!-- ============ SOBRE MÍ ============ -->
    <section class="row container" id="sobre-mi">
      <header class="row__label"><h2>Sobre mí</h2></header>
      <div class="row__body about">
        <p class="about__big">
          Crecí en Corrientes, arranqué Ingeniería en Sistemas en la UTN y hoy
          vivo en Buenos Aires, donde estudio <em>Gestión de Tecnologías de la
          Información</em> en UADE.
        </p>
        <p>
          Hoy soy Pasante de Ingeniería en <strong>OneCloud</strong>: implemento
          infraestructura de backup con Veeam, aprovisiono máquinas virtuales sobre
          VMware Cloud Director, pruebo configuraciones en un laboratorio Nutanix y
          administro servidores Ubuntu por SSH.
        </p>
        <p>
          Antes pasé por <strong>Amcor</strong>, donde hice soporte y gestión de accesos
          y dispositivos en un entorno multinacional. Ya aprobé <strong>CCNA:
          Introduction to Networks</strong>, sigo con el resto del CCNA y mi objetivo es seguir creciendo en
          infraestructura, cloud y automatización, hacia roles de DevOps y operaciones.
        </p>
        <p class="interests mono"><span>Intereses</span> {INTERESES.join(' / ')}</p>
      </div>
    </section>

    <!-- ============ EXPERIENCIA ============ -->
    <section class="row container" id="experiencia">
      <header class="row__label">
        <h2>Experiencia</h2>
        <p class="mono">{EXPERIENCIA.length} puestos</p>
      </header>
      <ol class="row__body entries">
        {EXPERIENCIA.map((t) => (
          <li class="entry">
            <div class="entry__meta mono">
              <span>{t.fecha}</span>
              {t.actual && <span class="badge">Actual</span>}
            </div>
            <div class="entry__body">
              <h3>{t.puesto}</h3>
              <p class="entry__place"><strong>{t.empresa}</strong> · {t.lugar}</p>
              {t.resumen && <p class="entry__text">{t.resumen}</p>}
              {t.logros && (
                <ul class="bullets">
                  {t.logros.map((l) => <li set:html={l} />)}
                </ul>
              )}
              {t.tags && <ul class="tags">{t.tags.map((tag) => <li>{tag}</li>)}</ul>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ============ PROYECTOS ============ -->
    <section class="row container" id="proyectos">
      <header class="row__label">
        <h2>Proyectos</h2>
        <p class="mono" id="filtroConteo" aria-live="polite">{PROYECTOS.length} proyectos</p>
      </header>
      <div class="row__body">
        <div class="filters" role="group" aria-label="Filtrar proyectos por tipo" hidden>
          <button type="button" data-tipo="todos" aria-pressed="true">Todos <span>{PROYECTOS.length}</span></button>
          {tipos.map((t) => (
            <button type="button" data-tipo={t.tipo} aria-pressed="false">{t.nombre} <span>{t.cantidad}</span></button>
          ))}
        </div>

        <div class="projects">
          {PROYECTOS.map((p) => {
            const foto = capturaDe(p.slug);
            const caso = `/proyectos/${p.slug}/`;
            return (
              <article class="project" data-tipo={p.tipo}>
                <a class="project__media" href={caso} tabindex="-1" aria-hidden="true" transition:name={`captura-${p.slug}`}>
                  {foto
                    ? <Picture src={foto} formats={['avif', 'webp']} widths={[480, 960]} sizes="(max-width: 700px) 100vw, 460px" alt="" />
                    : <pre class="project__term">{(p.sinCaptura ?? []).join('\n')}</pre>}
                </a>
                <div class="project__body">
                  <p class="project__meta mono">
                    <span>{p.etiqueta}</span>
                    {p.destacado && <span class="badge">{p.destacado}</span>}
                  </p>
                  <h3><a class="project__title" href={caso} transition:name={`titulo-${p.slug}`}>{p.titulo}</a></h3>
                  <p class="project__desc">{p.descripcion}</p>
                  <ul class="tags">{p.tags.map((tag) => <li>{tag}</li>)}</ul>
                  <div class="project__actions mono">
                    <a class="project__more" href={caso}>Ver caso →</a>
                    {p.links.demo && <a href={p.links.demo} target="_blank" rel="noopener">{p.links.textoDemo ?? 'Ver sitio'} ↗</a>}
                    {p.links.codigo && <a href={p.links.codigo} target="_blank" rel="noopener">Código ↗</a>}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ============ SKILLS ============ -->
    <section class="row container" id="skills">
      <header class="row__label"><h2>Skills</h2></header>
      <div class="row__body">
        <ul class="tags tags--big">{SKILLS.map((t) => <li>{t}</li>)}</ul>
        <h3 class="sublabel mono">Idiomas</h3>
        <dl class="kv">
          {IDIOMAS.map((i) => (
            <div><dt>{i.idioma}</dt><dd class="mono">{i.nivel}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <!-- ============ FORMACIÓN ============ -->
    <section class="row container" id="formacion">
      <header class="row__label"><h2>Formación</h2></header>
      <ol class="row__body entries">
        {FORMACION.map((e) => (
          <li class="entry">
            <div class="entry__meta mono"><span>{e.fecha}</span></div>
            <div class="entry__body">
              <h3>{e.titulo}</h3>
              <p class="entry__place">{e.institucion}</p>
              {e.detalle && <p class="entry__text">{e.detalle}</p>}
              {e.credencial && <a class="link mono" href={e.credencial.url} target="_blank" rel="noopener">{e.credencial.texto}</a>}
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ============ CONTACTO ============ -->
    <section class="row container" id="contacto">
      <header class="row__label"><h2>Contacto</h2></header>
      <div class="row__body">
        <p class="contact__lead">Si tenés un puesto o un proyecto de infraestructura, cloud o automatización, escribime.</p>
        <dl class="kv kv--contact">
          <div><dt class="mono">Email</dt><dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd></div>
          <div><dt class="mono">LinkedIn</dt><dd><a href={LINKEDIN} target="_blank" rel="noopener">augusto-roubineau ↗</a></dd></div>
          <div><dt class="mono">GitHub</dt><dd><a href={GITHUB} target="_blank" rel="noopener">AugstR ↗</a></dd></div>
          <div><dt class="mono">CV</dt><dd><a href="/cv.pdf" data-astro-reload>Descargar en PDF ↓</a></dd></div>
        </dl>
      </div>
    </section>

</Base>
